{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "GRCFGR",
            "Effect": "Deny",
            "Action": [
                "config:PutConfigRule",
                "config:DeleteConfigRule",
                "config:DeleteEvaluationResults",
                "config:UntagResource"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Accelerator": "${ACCELERATOR_PREFIX}"
                },
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRLMB",
            "Effect": "Deny",
            "Action": [
                "lambda:Add*",
                "lambda:Create*",
                "lambda:Delete*",
                "lambda:Invoke*",
                "lambda:Publish*",
                "lambda:Put*",
                "lambda:Remove*",
                "lambda:Update*"
            ],
            "Resource": [
                "arn:${PARTITION}:lambda:*:*:function:${ACCELERATOR_PREFIX}-Sec*",
                "arn:${PARTITION}:lambda:*:*:function:${ACCELERATOR_PREFIX}-Log*",
                "arn:${PARTITION}:lambda:*:*:function:${ACCELERATOR_PREFIX}-Net*",
                "arn:${PARTITION}:lambda:*:*:function:${ACCELERATOR_PREFIX}-Op*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRSNS",
            "Effect": "Deny",
            "Action": [
                "sns:AddPermission",
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:RemovePermission",
                "sns:SetTopicAttributes",
                "sns:Subscribe",
                "sns:Unsubscribe"
            ],
            "Resource": "arn:${PARTITION}:sns:*:*:aws-accelerator-*",
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRCWLG",
            "Effect": "Deny",
            "Action": [
                "logs:AssociateKmsKey",
                "logs:CreateLogGroup",
                "logs:DeleteLogGroup",
                "logs:DeleteLogStream",
                "logs:DeleteRetentionPolicy",
                "logs:DisassociateKmsKey",
                "logs:PutRetentionPolicy"
            ],
            "Resource": [
                "arn:${PARTITION}:logs:*:*:log-group:aws-accelerator-*",
                "arn:${PARTITION}:logs:*:*:log-group:aws-accelerator-*:log-stream:*",
                "arn:${PARTITION}:logs:*:*:log-group:/${ACCELERATOR_PREFIX}-*",
                "arn:${PARTITION}:logs:*:*:log-group:${ACCELERATOR_PREFIX}-sessionmanager-logs",
                "arn:${PARTITION}:logs:*:*:log-group:/aws/lambda/${ACCELERATOR_PREFIX}-Sec*",
                "arn:${PARTITION}:logs:*:*:log-group:/aws/lambda/${ACCELERATOR_PREFIX}-Log*",
                "arn:${PARTITION}:logs:*:*:log-group:/aws/lambda/${ACCELERATOR_PREFIX}-Net*",
                "arn:${PARTITION}:logs:*:*:log-group:/aws/lambda/${ACCELERATOR_PREFIX}-Op*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRKIN",
            "Effect": "Deny",
            "Action": [
                "kinesis:Create*",
                "kinesis:Decrease*",
                "kinesis:Delete*",
                "kinesis:Deregister*",
                "kinesis:Start*",
                "kinesis:Stop*",
                "kinesis:Update*",
                "firehose:Create*",
                "firehose:Delete*",
                "firehose:Start*",
                "firehose:Stop*",
                "firehose:Update*"
            ],
            "Resource": [
                "arn:${PARTITION}:firehose:*:*:deliverystream/${ACCELERATOR_PREFIX}*",
                "arn:${PARTITION}:kinesis:*:*:stream/${ACCELERATOR_PREFIX}*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GREB",
            "Effect": "Deny",
            "Action": [
                "events:PutRule",
                "events:PutTargets",
                "events:RemoveTargets",
                "events:DisableRule",
                "events:DeleteRule"
            ],
            "Resource": "arn:${PARTITION}:events:*:*:rule/${ACCELERATOR_PREFIX}*",
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRIAMR",
            "Effect": "Deny",
            "NotAction": [
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListRolePolicies",
                "iam:ListRoles"
            ],
            "Resource": [
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Log*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Sec*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Net*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Op*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Dep*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Ass*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Bac*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Cro*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Ses*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Ena*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/AWSServiceRoleForConfig"
                    ]
                }
            }
        },
        {
            "Sid": "GRIAMRT",
            "Effect": "Deny",
            "Action": [
                "iam:AttachRolePolicy",
                "iam:DeleteRole",
                "iam:DeleteRolePolicy",
                "iam:DetachRolePolicy",
                "iam:PutRolePolicy",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:UpdateAssumeRolePolicy",
                "iam:UpdateRole"
            ],
            "Resource": [
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Log*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Sec*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Net*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Op*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Dep*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Ass*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Bac*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Cro*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Ses*",
                "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}-Ena*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}"
                    ]
                }
            }
        },
        {
            "Sid": "GRCFM",
            "Effect": "Deny",
            "Action": [
                "cloudformation:Delete*"
            ],
            "Resource": [
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Log*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Sec*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Net*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Op*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Dep*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Key*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Cust*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-Res*",
                "arn:${PARTITION}:cloudformation:*:*:stack/${ACCELERATOR_PREFIX}-CDK*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRSSM",
            "Effect": "Deny",
            "Action": [
                "ssm:DeleteParameter*",
                "ssm:PutParameter"
            ],
            "Resource": [
                "arn:${PARTITION}:ssm:*:*:parameter/accelerator/${ACCELERATOR_PREFIX}-*",
                "arn:${PARTITION}:ssm:*:*:parameter/accelerator/iam/*",
                "arn:${PARTITION}:ssm:*:*:parameter/accelerator/kms/*",
                "arn:${PARTITION}:ssm:*:*:parameter/accelerator/security-stack/*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRS3",
            "Effect": "Deny",
            "Action": [
                "s3:Delete*",
                "s3:PutBucketLogging",
                "s3:PutBucketPolicy",
                "s3:PutBucketVersioning",
                "s3:PutEncryptionConfiguration",
                "s3:PutLifecycleConfiguration",
                "s3:PutObjectRetention",
                "s3:PutObjectTagging",
                "s3:PutReplicationConfiguration",
                "s3:ReplicateDelete"
            ],
            "Resource": [
                "arn:${PARTITION}:s3:::aws-accelerator*",
                "arn:${PARTITION}:s3:::cdk-accel*"
            ],
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        },
        {
            "Sid": "GRRU",
            "Effect": "Deny",
            "Action": "*",
            "Resource": "*",
            "Condition": {
                "ArnLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:root"
                    ]
                },
                "Null": {
                    "aws:AssumedRoot": "true"
                }
            }
        },
        {
            "Sid": "GRSEC",
            "Effect": "Deny",
            "Action": [
                "access-analyzer:DeleteAnalyzer",
                "account:DisableRegion",
                "account:EnableRegion",
                "ec2:CreateDefaultVpc",
                "ec2:DisableEbsEncryptionByDefault",
                "ec2:ModifyEbsDefaultKmsKeyId",
                "guardduty:AcceptInvitation",
                "guardduty:CreateMembers",
                "guardduty:DeclineInvitations",
                "guardduty:Delete*",
                "guardduty:Disassociate*",
                "guardduty:DisableOrganizationAdminAccount",
                "guardduty:InviteMembers",
                "guardduty:StopMonitoringMembers",
                "guardduty:UpdateDetector",
                "guardduty:UpdateFindingsFeedback",
                "guardduty:UpdateOrganizationConfiguration",
                "guardduty:UpdatePublishingDestination",
                "iam:CreateAccountAlias",
                "iam:CreateUser",
                "iam:DeleteAccount*",
                "iam:UpdateAccountPasswordPolicy",
                "macie2:AcceptInvitation",
                "macie2:CreateInvitations",
                "macie2:CreateMember",
                "macie2:DeclineInvitations",
                "macie2:DeleteInvitations",
                "macie2:DeleteMember",
                "macie2:DisableMacie",
                "macie2:DisableOrganizationAdminAccount",
                "macie2:Disassociate*",
                "macie2:Enable*",
                "macie2:UpdateMacieSession",
                "macie2:UpdateMemberSession",
                "macie2:UpdateOrganizationConfiguration",
                "organizations:LeaveOrganization*",
                "ram:AssociateResourceShare",
                "ram:CreateResourceShare",
                "ram:Delete*",
                "ram:Disassociate*",
                "ram:UntagResource",
                "ram:UpdateResourceShare",
                "s3:PutAccountPublicAccessBlock",
                "securityhub:AcceptInvitation",
                "securityhub:BatchDisableStandards",
                "securityhub:CreateMembers",
                "securityhub:DeclineInvitations",
                "securityhub:DeleteActionTarget",
                "securityhub:DeleteInsight",
                "securityhub:DeleteInvitations",
                "securityhub:DeleteMembers",
                "securityhub:Disassociate*",
                "securityhub:Disable*",
                "securityhub:InviteMembers",
                "securityhub:UpdateSecurityHubConfiguration",
                "securityhub:UpdateStandardsControl"
            ],
            "Resource": "*",
            "Condition": {
                "ArnNotLike": {
                    "aws:PrincipalArn": [
                        "arn:${PARTITION}:iam::*:role/${ACCELERATOR_PREFIX}*",
                        "arn:${PARTITION}:iam::*:role/${MANAGEMENT_ACCOUNT_ACCESS_ROLE}",
                        "arn:${PARTITION}:iam::*:role/cdk-accel*"
                    ]
                }
            }
        }
    ]
}